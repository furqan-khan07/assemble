# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/assembleai

# ─── Authentication ────────────────────────────────────────────────────────────
# Random 32+ character string for signing JWT session cookies
JWT_SECRET=change-me-to-a-random-32-char-string
# Email address that gets admin role automatically on login
ADMIN_EMAIL=your@email.com

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AWS S3 (file storage) ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=assembleai-uploads
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── Email notifications (optional) ───────────────────────────────────────────
# Gmail App Password for sending owner notifications
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
